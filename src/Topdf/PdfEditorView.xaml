<UserControl x:Class="Topdf.PdfEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewKeyDown="EditorShortcuts" Background="#EDF1F5">
 <UserControl.Resources>
  <Style x:Key="RibbonToolStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#243C50"/><Setter Property="Margin" Value="1,0"/><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="ToolBorder" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToolBorder" Property="Background" Value="#EDF3F8"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToolBorder" Property="Background" Value="#DDEFFA"/><Setter TargetName="ToolBorder" Property="BorderBrush" Value="#72AACB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="RibbonMenuStyle" TargetType="ToggleButton"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="28"/><Setter Property="Margin" Value="2,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#243C50"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="MenuBorder" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="#DCE3EA"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="MenuBorder" Property="Background" Value="#DDEFFA"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuBorder" Property="BorderBrush" Value="#72AACB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="White" Padding="6,3" BorderBrush="#D9E0E8" BorderThickness="0,0,0,1">
   <StackPanel>
    <DockPanel Margin="0,0,0,3">
     <Button x:Name="EditorSave" Content="저장" Click="SaveEditedPdf" DockPanel.Dock="Right" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center"/>
     <ToggleButton x:Name="MoreOptions" Content="⋯" ToolTip="속성 · 편집 파일 · 페이지" AutomationProperties.Name="더보기" DockPanel.Dock="Right" Width="28" Height="26" VerticalAlignment="Center" Background="White" BorderBrush="#DCE3EA"/>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel x:Name="EditorRibbon" Orientation="Horizontal"><RadioButton x:Name="ViewTool" Visibility="Collapsed" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="-1" ToolTip="보기 (Esc)" AutomationProperties.Name="보기" Click="RibbonToolClicked"><StackPanel><Path Data="M1,11 C7,1 15,1 21,11 C15,21 7,21 1,11 Z M14,11 A3,3 0 1 1 8,11 A3,3 0 1 1 14,11" Stroke="#243C50" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></StackPanel></RadioButton><RadioButton Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="1" ToolTip="선택" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="선택"><StackPanel><Path Data="M4,2 L4,18 L8,14 L12,21 L15,19 L11,12 L17,12 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/></StackPanel></RadioButton><ToggleButton x:Name="TextToolsButton" Style="{StaticResource RibbonMenuStyle}" ToolTip="글자" AutomationProperties.Name="글자"><StackPanel Orientation="Horizontal"><Path Data="M3,4 L19,4 M11,4 L11,20 M7,20 L15,20" Stroke="#243C50" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="⌄" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel></ToggleButton><ToggleButton x:Name="DrawingToolsButton" Style="{StaticResource RibbonMenuStyle}" ToolTip="그리기" AutomationProperties.Name="그리기"><StackPanel Orientation="Horizontal"><Path Data="M3,19 L19,3 M9,3 L19,3 L19,13" Stroke="#243C50" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="⌄" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel></ToggleButton><ToggleButton x:Name="MarkupToolsButton" Style="{StaticResource RibbonMenuStyle}" ToolTip="표시" AutomationProperties.Name="표시"><StackPanel Orientation="Horizontal"><Path Data="M5,12 L13,3 L19,9 L11,18 Z M5,12 L3,20 L11,18 M2,21 L20,21" Stroke="#243C50" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="⌄" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel></ToggleButton><RadioButton Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="4" ToolTip="도장" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="도장"><StackPanel><Path Data="M7,12 L7,8 C3,0 19,0 15,8 L15,12 M5,12 L17,12 L19,17 L3,17 Z M3,20 L19,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/></StackPanel></RadioButton>
       <ToggleButton x:Name="PenOptions" Width="32" Height="28" Background="White" BorderBrush="#DCE3EA" ToolTip="색상 · 선 두께" AutomationProperties.Name="펜 설정"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="PenColorChip" Width="14" Height="14" Fill="#111111" Stroke="#9AA8B5"/><TextBlock Text="⌄" Margin="5,0,0,0"/></StackPanel></ToggleButton>
       <TextBox x:Name="EditPageNumber" Width="34" Height="24" Text="1" ToolTip="페이지 번호" PreviewKeyDown="PageNumberKey" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
       <Button Content="이동" Click="GoToPage" Padding="5,3" VerticalAlignment="Center" Margin="2,0,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
    <Popup PlacementTarget="{Binding ElementName=TextToolsButton}" Placement="Bottom" IsOpen="{Binding IsChecked,ElementName=TextToolsButton,Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#D5DFE8" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,4,0,0"><StackPanel x:Name="TextTools" Orientation="Horizontal"><RadioButton Width="68" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="0" ToolTip="기존 본문 수정" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="본문" IsChecked="True" Height="44"><StackPanel><Path Data="M4,3 L16,3 M4,8 L12,8 M4,13 L11,13 M15,9 L15,20 M12,9 L18,9 M12,20 L18,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="본문 수정" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton><RadioButton Width="68" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="2" ToolTip="글자" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="글자" Height="44"><StackPanel><Path Data="M3,4 L19,4 M11,4 L11,20 M7,20 L15,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="글자 추가" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton></StackPanel></Border></Popup>
    <Popup PlacementTarget="{Binding ElementName=DrawingToolsButton}" Placement="Bottom" IsOpen="{Binding IsChecked,ElementName=DrawingToolsButton,Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#D5DFE8" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,4,0,0"><StackPanel x:Name="DrawingTools" Orientation="Horizontal"><RadioButton Width="52" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="5" ToolTip="선" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="선" Height="44"><StackPanel><Path Data="M3,19 L19,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="선" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton><RadioButton Width="52" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="6" ToolTip="화살표" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="화살표" Height="44"><StackPanel><Path Data="M3,19 L19,3 M9,3 L19,3 L19,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="화살표" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton><RadioButton Width="52" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="7" ToolTip="사각형" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="사각형" Height="44"><StackPanel><Path Data="M3,4 L19,4 L19,18 L3,18 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="사각형" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton><RadioButton Width="52" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="8" ToolTip="타원" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="타원" Height="44"><StackPanel><Path Data="M2,11 C2,-1 20,-1 20,11 C20,23 2,23 2,11 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="타원" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton><RadioButton Width="52" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="12" ToolTip="자유곡선" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="자유곡선" Height="44"><StackPanel><Path Data="M2,17 C6,2 10,2 11,11 C12,21 17,21 20,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="자유곡선" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton></StackPanel></Border></Popup>
    <Popup PlacementTarget="{Binding ElementName=MarkupToolsButton}" Placement="Bottom" IsOpen="{Binding IsChecked,ElementName=MarkupToolsButton,Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#D5DFE8" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,4,0,0"><StackPanel x:Name="MarkupTools" Orientation="Horizontal"><RadioButton Width="52" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="3" ToolTip="메모" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="메모" Height="44"><StackPanel><Path Data="M3,3 L19,3 L19,15 L12,15 L7,20 L7,15 L3,15 Z M6,7 L16,7 M6,11 L13,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="메모" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton><RadioButton Width="52" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="9" ToolTip="형광펜" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="형광펜" Height="44"><StackPanel><Path Data="M5,12 L13,3 L19,9 L11,18 Z M5,12 L3,20 L11,18 M2,21 L20,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="형광펜" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton><RadioButton Width="52" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="10" ToolTip="밑줄" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="밑줄" Height="44"><StackPanel><Path Data="M5,3 L5,11 C5,19 17,19 17,11 L17,3 M3,21 L19,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="밑줄" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton><RadioButton Width="52" Style="{StaticResource RibbonToolStyle}" GroupName="PdfRibbonTools" Tag="11" ToolTip="취소선" Checked="RibbonToolChecked" Click="RibbonToolClicked" AutomationProperties.Name="취소선" Height="44"><StackPanel><Path Data="M17,5 C9,-1 2,6 11,11 C21,16 13,24 5,18 M2,11 L20,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="취소선" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton></StackPanel></Border></Popup>
    <Popup x:Name="PenPopup" PlacementTarget="{Binding ElementName=PenOptions}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=PenOptions, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
     <Border Background="White" BorderBrush="#D5DFE8" BorderThickness="1" CornerRadius="8" Padding="18" Width="290" Margin="0,4,6,6">
      <StackPanel><TextBlock Text="색상" FontWeight="SemiBold" Foreground="#243C50" Margin="0,0,0,12"/>
       <UniformGrid x:Name="PenPalette" Columns="6"/>
       <Path x:Name="PenPreview" Data="M4,30 C55,-10 110,65 180,15" Stroke="#111111" StrokeThickness="2" Width="244" Height="48" Stretch="Fill" Margin="0,18,0,14"/>
       <DockPanel><TextBlock Text="두께" FontWeight="SemiBold" Foreground="#243C50"/><TextBlock x:Name="PenWidthLabel" Text="2 pt" HorizontalAlignment="Right" Foreground="#64798B"/></DockPanel>
       <Slider x:Name="PenWidthSlider" Minimum="1" Maximum="8" Value="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="PenWidthChanged" Margin="0,12,0,5"/>
       <DockPanel><TextBlock Text="가늘게" Foreground="#64798B" FontSize="11"/><TextBlock Text="굵게" HorizontalAlignment="Right" Foreground="#64798B" FontSize="11"/></DockPanel>
      </StackPanel>
     </Border>
    </Popup>
    <DockPanel x:Name="TextProperties" Visibility="Collapsed" Margin="0,4,0,3">
<WrapPanel x:Name="EditorTools">
<Button Content="이동" Click="GoToPage" Padding="7,3" Margin="0,0,6,0"/>
      <ComboBox x:Name="EditTool" Visibility="Collapsed" SelectionChanged="RibbonSelectionChanged" Width="100" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="본문"/><ComboBoxItem Content="선택"/><ComboBoxItem Content="글자"/><ComboBoxItem Content="메모"/><ComboBoxItem Content="도장"/><ComboBoxItem Content="선"/><ComboBoxItem Content="화살표"/><ComboBoxItem Content="사각형"/><ComboBoxItem Content="타원"/><ComboBoxItem Content="형광펜"/><ComboBoxItem Content="밑줄"/><ComboBoxItem Content="취소선"/><ComboBoxItem Content="자유곡선"/></ComboBox>
      <TextBox x:Name="EditText" Width="160" Height="30" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="추가할 글자 또는 메모" Margin="0,0,6,0"/>
      <ComboBox x:Name="EditFontSize" Width="56" SelectedIndex="1" Margin="0,0,6,0"><ComboBoxItem Content="10"/><ComboBoxItem Content="14"/><ComboBoxItem Content="18"/><ComboBoxItem Content="24"/><ComboBoxItem Content="36"/><ComboBoxItem Content="48"/></ComboBox>
      <ComboBox x:Name="EditColor" Visibility="Collapsed" Width="60" SelectedIndex="0" Margin="0,0,6,0"><ComboBoxItem Content="검정"/><ComboBoxItem Content="빨강"/><ComboBoxItem Content="파랑"/><ComboBoxItem Content="초록" Tag="#16804A"/><ComboBoxItem Content="보라" Tag="#7B3FB3"/><ComboBoxItem Content="노랑" Tag="#FFEB3B"/><ComboBoxItem Content="주황" Tag="#E77A19"/></ComboBox>
      <Button Content="내용 적용" Click="ApplySelectedText" Padding="8,5" Margin="0,0,6,0"/>
<Button Content="−" Click="ShrinkElement" Padding="8,5" ToolTip="선택 항목 축소"/>
<Button Content="항목 삭제" Click="DeleteElement" Padding="8,5"/>
     </WrapPanel>
    </DockPanel>
    <Popup PlacementTarget="{Binding ElementName=MoreOptions}" Placement="Bottom" IsOpen="{Binding IsChecked,ElementName=MoreOptions,Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Width="550" Padding="12" CornerRadius="6" BorderBrush="#D5DFE8" BorderThickness="1" Background="White">
    <WrapPanel x:Name="EditorHistory">
      <Button Content="+" Click="GrowElement" Padding="8,5" ToolTip="선택 항목 확대" Margin="0,0,6,0"/>
      <Button Content="도장 선택" Click="ChooseStamp" Padding="8,5"/>
     <Button Content="편집 저장" Click="SaveProject" Padding="8,5"/>
     <Button Content="편집 열기" Click="OpenProject" Padding="8,5"/>
     <ComboBox x:Name="StrokeSize" Width="45" SelectedIndex="1"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/><ComboBoxItem Content="8"/></ComboBox>
     <CheckBox x:Name="DashStroke" Content="점선" VerticalAlignment="Center" Margin="4"/>
     <CheckBox x:Name="FillShape" Content="채움" VerticalAlignment="Center" Margin="4"/>
     <ComboBox x:Name="TextAlign" Width="60" SelectedIndex="0"><ComboBoxItem Content="왼쪽"/><ComboBoxItem Content="가운데"/><ComboBoxItem Content="오른쪽"/></ComboBox>
     <ComboBox x:Name="TextFont" Width="95" SelectedIndex="0"><ComboBoxItem Content="Malgun Gothic"/><ComboBoxItem Content="Gulim"/><ComboBoxItem Content="Batang"/></ComboBox>
     <Button Content="속성 적용" Click="ApplyStyle" Padding="8,5"/>
     <Button Content="복제" Click="DuplicateObjects" Padding="8,5"/>
     <Button Content="회전" Click="RotateObjects" Padding="8,5"/>
     <Button Content="맨 앞" Click="BringForward" Padding="8,5"/>
     <Button Content="맨 뒤" Click="SendBackward" Padding="8,5"/>
     <Button Content="되돌리기" Click="UndoEdit" Padding="10,5" Margin="0,0,6,0"/>
     <Button Content="다시 실행" Click="RedoEdit" Padding="10,5" Margin="0,0,14,0"/>
     <Button Content="쪽 회전 ↶" Click="RotateLeft" Padding="10,5" Margin="0,0,6,0"/>
     <Button Content="쪽 회전 ↷" Click="RotateRight" Padding="10,5" Margin="0,0,6,0"/>
     <Button Content="쪽 삭제" Click="DeletePage" Padding="10,5" Margin="0,0,14,0"/>
     <Button Content="앞으로" Click="MovePageUp" Padding="10,5" Margin="0,0,6,0"/>
     <Button Content="뒤로" Click="MovePageDown" Padding="10,5" Margin="0,0,14,0"/>
     <ComboBox x:Name="EditZoom" Width="80" SelectedIndex="1" SelectionChanged="ZoomChanged"><ComboBoxItem Content="75%"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="125%"/><ComboBoxItem Content="150%"/></ComboBox>
    </WrapPanel>
    </Border></Popup>
   </StackPanel>
  </Border>
  <TextBlock x:Name="EditStatus" DockPanel.Dock="Bottom" Padding="12,7" Text="PDF를 준비하고 있습니다…" TextWrapping="Wrap"/>
  <Grid>
   <ContentControl x:Name="NativeViewingHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <DockPanel x:Name="EditingArea">
  <DockPanel DockPanel.Dock="Left" Width="115" Margin="8">
   <ListBox x:Name="EditPages" DisplayMemberPath="Label" SelectionChanged="EditorPageChanged"/>
  </DockPanel>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#68727C" Padding="20">
   <Grid x:Name="EditSurface" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White">
    <Image x:Name="EditPageImage" Stretch="Fill"/>
    <Canvas x:Name="EditCanvas" LostMouseCapture="CanvasCaptureLost" Focusable="True" Background="Transparent" MouseLeftButtonDown="PageMouseDown" MouseMove="PageMouseMove" MouseLeftButtonUp="PageMouseUp"/>
   </Grid>
  </ScrollViewer>
   </DockPanel>
  </Grid>
 </DockPanel>
</UserControl>
