<Window x:Class="Topdf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="TOPDF · PDF 편집기" Icon="Assets/topdf-logo.png" Width="1280" Height="800" MinWidth="720" MinHeight="480" AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="HandleShortcuts" Background="#EDF1F5">
 <Window.Resources>
  <DataTemplate x:Key="SmartEvidenceTemplate"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="2,5"/></DataTemplate>
  <Style x:Key="SmartEvidenceItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 </Window.Resources>
 <Grid x:Name="LayoutRoot">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DEE5ED" BorderThickness="0,0,0,1">
   <DockPanel>
    <ContentControl x:Name="WindowActionsHost" DockPanel.Dock="Right" VerticalAlignment="Center">
     <StackPanel x:Name="WindowActions" Orientation="Horizontal">
      <Button x:Name="EditPdfButton" Visibility="Collapsed" Content="수정" Click="EditPdf"/>
      <ToggleButton x:Name="SmartToggle" Content="스마트" Padding="7,2" Height="26" Margin="4,0" VerticalAlignment="Center"/>
      <Button x:Name="FullscreenButton" Content="전체 화면  F11" Click="ToggleFullscreen" Padding="7,2" Height="26" Margin="0,0,4,0" VerticalAlignment="Center"/>
     </StackPanel>
    </ContentControl>
    <ToggleButton x:Name="MenuToggle" Visibility="Collapsed" DockPanel.Dock="Left"/>
    <Menu x:Name="MainMenu" Background="#F5F7FA" Padding="4,1">
     <MenuItem Header="파일(_F)" SubmenuOpened="FileMenuOpened">
      <MenuItem Header="열기(_O)…" InputGestureText="Ctrl+O" Click="AddFiles"/>
      <MenuItem Header="열린 파일 목록" InputGestureText="Ctrl+M" Click="OpenMenu"/>
      <MenuItem Header="복구 파일 열기…" Click="OpenRecovery"/>
      <Separator/>
      <MenuItem x:Name="MenuSaveProject" Header="편집 파일 저장…" InputGestureText="Ctrl+S" Command="ApplicationCommands.Save"/>
      <MenuItem x:Name="MenuExportPdf" Header="PDF 내보내기…" InputGestureText="Ctrl+Shift+S" Command="ApplicationCommands.SaveAs"/>
      <MenuItem x:Name="MenuCloseTab" Header="문서 닫기" InputGestureText="Ctrl+W" Click="CloseSelectedDocument"/>
      <Separator/>
      <MenuItem x:Name="RecentFileMenu" Header="최근 파일"/>
      <Separator/>
      <MenuItem Header="끝내기(_X)" InputGestureText="Ctrl+Q" Click="ExitApplication"/>
     </MenuItem>
     <MenuItem Header="편집(_E)" SubmenuOpened="EditMenuOpened">
      <MenuItem Header="실행 취소" Command="ApplicationCommands.Undo"/>
      <MenuItem Header="다시 실행" Command="ApplicationCommands.Redo"/>
      <Separator/>
      <MenuItem Header="잘라내기" Command="ApplicationCommands.Cut"/>
      <MenuItem Header="복사" Command="ApplicationCommands.Copy"/>
      <MenuItem Header="붙여넣기" Command="ApplicationCommands.Paste"/>
      <MenuItem Header="삭제" Command="ApplicationCommands.Delete"/>
      <MenuItem Header="전체 선택" Command="ApplicationCommands.SelectAll"/>
      <Separator/>
      <MenuItem x:Name="MenuFind" Header="찾기…" InputGestureText="Ctrl+F" Click="FindFromMenu"/>
     </MenuItem>
     <MenuItem Header="보기(_V)" SubmenuOpened="ViewMenuOpened">
      <MenuItem Header="목차" Tag="outline" Click="ViewMenuAction"/>
      <MenuItem Header="객체 특성창" Tag="properties" IsCheckable="True" Click="ViewMenuAction"/>
      <MenuItem Header="한 페이지" Tag="1" Click="ViewMenuAction"/>
      <MenuItem Header="두 페이지" Tag="2" Click="ViewMenuAction"/>
      <MenuItem Header="세 페이지" Tag="3" Click="ViewMenuAction"/>
      <Separator/>
      <MenuItem Header="너비 맞춤" Tag="width" InputGestureText="Ctrl+0" Click="ViewMenuAction"/>
      <MenuItem Header="페이지 맞춤" Tag="page" Click="ViewMenuAction"/>
      <Separator/>
      <MenuItem Header="전체 화면 전환" InputGestureText="F11" Click="ToggleFullscreen"/>
     </MenuItem>
     <MenuItem Header="창(_W)" SubmenuOpened="WindowMenuOpened"><MenuItem Header="열린 문서 없음" IsEnabled="False"/></MenuItem>
     <MenuItem x:Name="HelpMenu" Header="도움말(_H)">
      <MenuItem Header="키보드 단축키" Click="ShowMenuShortcuts"/>
      <MenuItem Header="TOPDF 정보" Click="ShowAppInformation"/>
     </MenuItem>
    </Menu>
   </DockPanel>
  </Border>
  <ListBox x:Name="DocumentTabs" Grid.Row="1" SelectedItem="{Binding SelectedItem, ElementName=Files, Mode=TwoWay}" BorderThickness="0" Background="#F5F7FA" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="Single">
   <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ListBox.Style>
   <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemTemplate><DataTemplate><DockPanel Width="174" ToolTip="{Binding Source}"><Button Content="×" Click="CloseDocument" DockPanel.Dock="Right" Padding="5,0" Margin="5,0,0,0" ToolTip="문서 닫기" AutomationProperties.Name="문서 닫기"/><TextBlock Text="{Binding TabName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Grid x:Name="PreviewHost" Grid.Row="2" Background="White">
   <wv:WebView2 x:Name="PdfViewer" Visibility="Hidden"/>
   <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24">
    <TextBlock Text="문서를 크게, 바로 보세요" FontSize="24" FontWeight="SemiBold" Foreground="#17324D" HorizontalAlignment="Center" Margin="0,0,0,14"/>
    <TextBlock x:Name="PreviewMessage" Text="파일을 끌어놓거나 파일 메뉴에서 열기를 선택하세요." TextAlignment="Center" TextWrapping="Wrap" Foreground="#607080" FontSize="14"/>
    <Button Content="파일 열기" Click="AddFiles" Padding="24,10" HorizontalAlignment="Center" Margin="0,20,0,0"/>
   </StackPanel>
   <ContentControl x:Name="InlineEditorHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
  <Border Grid.Row="3" Background="#F5F7FA" BorderBrush="#DEE5ED" BorderThickness="0,1,0,0" Padding="12,6">
   <TextBlock x:Name="Summary" Text="준비" TextTrimming="CharacterEllipsis" Foreground="#607080" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Border>
  <!-- Popup owns a separate HWND so it remains above the native WebView2 PDF surface. -->
  <Popup x:Name="ActionMenu" IsOpen="{Binding IsChecked, ElementName=MenuToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=MainMenu}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True">
   <Border x:Name="MenuPanel" Width="400" MaxHeight="{Binding ActualHeight, ElementName=PreviewHost}" Background="White" BorderBrush="#CCD6E2" BorderThickness="1" CornerRadius="8" Padding="10" PreviewKeyDown="HandleShortcuts">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <DockPanel Margin="0,0,0,8">
       <Button Content="✕" Click="CloseMenu" DockPanel.Dock="Right" Padding="8,4" ToolTip="닫기 (Esc)" AutomationProperties.Name="메뉴 닫기"/>
       <StackPanel Orientation="Horizontal">
        <Button Content="복구" Click="OpenRecovery" Padding="8,5" Margin="0,0,6,0"/><Button Content="열기" ToolTip="파일 열기 (Ctrl+O)" Click="AddFiles" Padding="10,5" Margin="0,0,6,0"/>
        <Button Content="변환 재시도" Click="ConvertFiles" Padding="10,5" Margin="0,0,6,0"/>
        <Button Content="현재 PDF 내보내기" Click="SavePdf" Padding="10,5" ToolTip="선택된 문서를 새 PDF로 저장"/>
       </StackPanel>
      </DockPanel>
      <DataGrid x:Name="Files" SelectionChanged="SelectionChanged" PreviewMouseLeftButtonUp="PreviewRowClicked" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" Background="White" Margin="0,0,0,8">
       <DataGrid.Style><Style TargetType="DataGrid"><Setter Property="Height" Value="200"/><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Height" Value="68"/></Trigger></Style.Triggers></Style></DataGrid.Style>
       <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="선택" Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="PDF 저장 선택"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="파일" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="54"/><DataGridTextColumn x:Name="QualityColumn" Header="점검" Binding="{Binding Quality}" Width="60"/>
       </DataGrid.Columns>
      </DataGrid>
      <DockPanel Margin="0,0,0,6">
       <Button x:Name="SaveCheckedButton" Content="선택 저장 (0)" Click="SaveCheckedPdfs" DockPanel.Dock="Right" Padding="10,5"/>
       <StackPanel Orientation="Horizontal"><Button Content="전체 선택" Click="CheckAll" Padding="8,5" Margin="0,0,6,0"/><Button Content="선택 해제" Click="UncheckAll" Padding="8,5"/></StackPanel>
      </DockPanel>
      <Expander Header="더보기" IsExpanded="False">
       <StackPanel Margin="0,8,0,0">
        <WrapPanel><Button Content="변환 취소" Click="CancelConversion" Padding="8,5" Margin="0,0,6,6"/><Button Content="외부 앱으로 열기" Click="OpenPdf" Padding="8,5" Margin="0,0,6,6"/><Button Content="연결 프로그램 등록" Click="RegisterFileAssociations" Padding="8,5" Margin="0,0,0,6"/></WrapPanel>
        <CheckBox x:Name="CompatibilityMode" Content="설치형 호환 모드" Checked="ModeChanged" Unchecked="ModeChanged" ToolTip="한글·LibreOffice·ODA 사용" Margin="0,3,0,3"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Popup>

  <Popup x:Name="SmartPopup" IsOpen="{Binding IsChecked, ElementName=SmartToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SmartToggle}" Placement="Bottom" HorizontalOffset="-400" StaysOpen="False" AllowsTransparency="True" VerticalOffset="8">
   <Border Width="480" Height="460" MaxHeight="{Binding ActualHeight, ElementName=PreviewHost}" Padding="10" CornerRadius="8" BorderBrush="#CCD6E2" BorderThickness="1" Background="White" PreviewKeyDown="HandleShortcuts">
    <TabControl>
     <TabItem Header="점검"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><Button Content="문서 점검" Click="RefreshQuality" Padding="10,5" Margin="0,0,8,8"/><Button Content="스캔 문자 읽기 (OCR)" Click="RunOcr" Padding="10,5" Margin="0,0,0,8"/></StackPanel>
      <TextBlock x:Name="QualityNotice" Grid.Row="1" TextWrapping="Wrap" Foreground="#607080" Margin="0,0,0,8"/>
      <ListBox x:Name="QualityList" Grid.Row="2" MouseDoubleClick="OpenEvidence" ItemTemplate="{StaticResource SmartEvidenceTemplate}" ItemContainerStyle="{StaticResource SmartEvidenceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
     </Grid></TabItem>
     <TabItem Header="검색"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button Content="검색" Click="SearchDocuments" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,8"/><TextBox x:Name="SearchQuery" Margin="0,0,0,8" VerticalContentAlignment="Center"/></DockPanel>
      <TextBlock x:Name="SearchNotice" Grid.Row="1" TextWrapping="Wrap" Foreground="#607080" Margin="0,0,0,8"/>
      <ListBox x:Name="SearchResults" Grid.Row="2" MouseDoubleClick="OpenEvidence" ItemTemplate="{StaticResource SmartEvidenceTemplate}" ItemContainerStyle="{StaticResource SmartEvidenceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
     </Grid></TabItem>
     <TabItem Header="비교"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button Content="현재 문서와 비교" Click="CompareDocuments" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,8"/><ComboBox x:Name="CompareTarget" DisplayMemberPath="Name" Margin="0,0,0,8"/></DockPanel>
      <TextBlock x:Name="CompareNotice" Grid.Row="1" TextWrapping="Wrap" Foreground="#607080" Margin="0,0,0,8"/>
      <ListBox x:Name="CompareResults" Grid.Row="2" MouseDoubleClick="OpenEvidence" ItemTemplate="{StaticResource SmartEvidenceTemplate}" ItemContainerStyle="{StaticResource SmartEvidenceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
     </Grid></TabItem>
     <TabItem Header="요약·질문"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBox x:Name="Question" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8" ToolTip="빈 질문은 주요 내용 요약 · 질문을 입력하면 관련 근거를 찾습니다."/>
      <WrapPanel Grid.Row="1"><Button Content="근거 찾기" Click="ExtractEvidence" Padding="8,5" Margin="0,0,6,6"/><Button Content="로컬 모델" Click="RefreshModels" Padding="8,5" Margin="0,0,6,6"/><ComboBox x:Name="LocalModels" Width="140" Margin="0,0,6,6"/><Button Content="AI 답변" Click="AskLocalAi" Padding="8,5" Margin="0,0,0,6"/></WrapPanel>
      <ScrollViewer Grid.Row="2" MaxHeight="150" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AnswerText" TextWrapping="Wrap" Margin="0,0,0,8"/></ScrollViewer>
      <ListBox x:Name="AnswerResults" Grid.Row="3" MouseDoubleClick="OpenEvidence" ItemTemplate="{StaticResource SmartEvidenceTemplate}" ItemContainerStyle="{StaticResource SmartEvidenceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
     </Grid></TabItem>
     <TabItem Header="자동화"><StackPanel Margin="8">
      <Button Content="입력 폴더" Click="PickWatchFolder" Padding="10,5" HorizontalAlignment="Left"/><TextBlock x:Name="WatchInput" TextWrapping="Wrap" Margin="0,4,0,12"/>
      <Button Content="저장 폴더" Click="PickExportFolder" Padding="10,5" HorizontalAlignment="Left"/><TextBlock x:Name="WatchOutput" TextWrapping="Wrap" Margin="0,4,0,12"/>
      <StackPanel Orientation="Horizontal"><Button Content="감시 시작" Click="StartWatching" Padding="10,5" Margin="0,0,8,0"/><Button Content="중지" Click="StopWatching" Padding="10,5"/></StackPanel>
      <TextBlock x:Name="WatchNotice" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#607080"/>
     </StackPanel></TabItem>
    </TabControl>
   </Border>
  </Popup>
 </Grid>
</Window>
