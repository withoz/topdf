<Window x:Class="Topdf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="TOPDF · 모든 문서를 읽는 앱 (현재 5가지)" Icon="Assets/topdf-logo.png" Width="1280" Height="800" MinWidth="900" MinHeight="540" AllowDrop="True" Drop="FilesDropped" Background="#F5F7FA">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top">
   <StackPanel Orientation="Horizontal"><Image Source="Assets/topdf-logo.png" Width="42" Height="42" Margin="0,0,10,0"/><TextBlock Text="TOPDF" FontSize="28" FontWeight="Bold" Foreground="#17324D" VerticalAlignment="Center"/></StackPanel>
   <TextBlock Text="모든 문서를 읽는 앱 — 현재 5가지 문서 형식 지원" Margin="0,8,0,4" FontWeight="SemiBold"/>
   <TextBlock Text="한글 · 워드 · 엑셀 · DWG · DXF | 파일을 끌어놓으면 PDF로 바로 봅니다." Margin="0,0,0,18" Foreground="#607080"/>
   <WrapPanel Margin="0,0,0,16">
    <Button Content="파일 추가" Click="AddFiles" Padding="18,8" Margin="0,0,8,0"/>
    <Button Content="변환 시작" Click="ConvertFiles" Padding="18,8" Margin="0,0,8,0"/>
    <Button Content="취소" Click="CancelConversion" Padding="18,8" Margin="0,0,8,0"/>
    <Button Content="외부 앱으로 열기" Click="OpenPdf" Padding="18,8" Margin="0,0,8,0"/>
    <Button x:Name="SaveCheckedButton" Content="체크한 PDF 저장 (0)" Click="SaveCheckedPdfs" Padding="18,8" Margin="0,0,8,0"/>
    <Button Content="현재 PDF 저장" Click="SavePdf" Padding="18,8"/>
   </WrapPanel>
   <WrapPanel Margin="0,0,0,12">
    <Button Content="전체 선택" Click="CheckAll" Padding="12,5" Margin="0,0,8,0"/>
    <Button Content="선택 해제" Click="UncheckAll" Padding="12,5" Margin="0,0,12,0"/>
    <TextBlock Text="저장할 파일을 체크한 뒤 저장 폴더를 선택하세요." VerticalAlignment="Center" Foreground="#607080"/>
    <Button Content="연결 프로그램 등록" Click="RegisterFileAssociations" Padding="12,5" Margin="16,0,0,0"/>
   </WrapPanel>
   <CheckBox x:Name="CompatibilityMode" Content="설치형 호환 모드 사용 (한글·LibreOffice·ODA)" Checked="ModeChanged" Unchecked="ModeChanged" Margin="0,0,0,12"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <TextBlock x:Name="Summary" Text="파일을 추가해 주세요." TextWrapping="Wrap"/>
   <TextBlock Text="Office · 한글 · DWG/DXF → PDF · 파일 선택 시 미리보기" Foreground="#607080" Margin="0,8,0,0" TextWrapping="Wrap"/>
   <TextBlock Text="CAD는 A3 도면 전체 맞춤 미리보기입니다. 정밀 출력 전 축척·글꼴을 확인하세요." Foreground="#607080" Margin="0,4,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="440" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
  <DataGrid x:Name="Files" SelectionChanged="SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" Background="White">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="저장" Width="48">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="PDF 저장 선택"/></DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="파일" Binding="{Binding Name}" Width="2*"/>
    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="100"/>
    <DataGridTextColumn Header="안내" Binding="{Binding Detail}" Width="2*"/>
   </DataGrid.Columns>
  </DataGrid>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#DEE4EC"/>
   <Grid Grid.Column="2" Background="White">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="PreviewTitle" Text="PDF 미리보기" FontWeight="SemiBold" Margin="14,10" TextTrimming="CharacterEllipsis"/>
    <wv:WebView2 x:Name="PdfViewer" Grid.Row="1" Visibility="Hidden"/>
    <TextBlock x:Name="PreviewMessage" Grid.Row="1" Text="PDF 또는 변환이 완료된 파일을 선택하세요." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" Margin="20" Foreground="#607080"/>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
